FROM alpine:3.24@sha256:be2656061b536c1883c4034790e21d0a09c5aaaf51968b89368a3c0371ea2c9a AS patched-arm-certificates
RUN apk add --no-cache 'ca-certificates>=20261020-r0'

FROM alpine:3.6@sha256:66790a2b79e1ea3e1dabac43990c54aca5d1ddf268d9a5a0285e4167c8b24475
RUN apk add --no-cache ca-certificates
COPY --from=patched-arm-certificates /usr/share/ca-certificates/ /usr/share/ca-certificates/
COPY --from=patched-arm-certificates /etc/ca-certificates.conf /etc/ca-certificates.conf
RUN rm -f /usr/share/ca-certificates/mozilla/AAA_Certificate_Services.crt /usr/share/ca-certificates/mozilla/Comodo_AAA_Services_root.crt /usr/share/ca-certificates/mozilla/emSign_ECC_Root_CA_-_G3.crt \
    && printf '%s\n' '!mozilla/AAA_Certificate_Services.crt' '!mozilla/Comodo_AAA_Services_root.crt' '!mozilla/emSign_ECC_Root_CA_-_G3.crt' >> /etc/ca-certificates.conf \
    && update-ca-certificates --fresh
ENV GODEBUG netdns=go


ADD release/linux/arm/plugin /bin/
ENTRYPOINT ["/bin/plugin"]
